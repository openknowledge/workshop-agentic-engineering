{
  "name": "customer-management-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.ts\"",
    "prettier:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"*.ts\"",
    "preview": "vite preview",
    "prepare": "cd .. && husky customer-management-client/.husky"
  },
  "lint-staged": {
    "{src/**/*.{ts,tsx,css,json},*.ts}": "prettier --check"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.166.2",
    "@tanstack/react-table": "^9.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^8.3.4"
  }
}
