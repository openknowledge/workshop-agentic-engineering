# === Build output (rebuilt in the container) ===
customer-management-client/node_modules
customer-management-client/dist
customer-management-client/target
customer-management-server/target

# === IDE/editor metadata ===
.idea
.vscode
*.iml
**/.classpath
**/.project
**/.checkstyle
**/.java-version
**/.settings

# === Git ===
.git
.gitignore
.github/
.gitattributes

# === Maven wrapper (not needed in the build image) ===
**/mvnw
**/mvnw.cmd
**/.mvn

# === Local configuration (must not end up in the image) ===
**/spring.profiles.active.local.properties
**/application-local.properties

# === Documentation / setup ===
README.md
LICENSE

# === Docker / CI artifacts (do NOT exclude the Dockerfile itself!) ===
docker-compose*.yaml
docker-compose*.yml

# === Other artifacts ===
*.log
.DS_Store
Thumbs.db
